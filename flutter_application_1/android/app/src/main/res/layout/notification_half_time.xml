<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="128dp"
    android:background="#0D0D1A">

    <!-- Background Flag -->
    <ImageView
        android:id="@+id/ht_bg_flag"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.45" />

    <!-- Dark Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C000000" />

    <!-- Sweep Line (Animation) -->
    <View
        android:id="@+id/ht_sweep_line"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_gravity="center_vertical"
        android:background="#FF9800" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- HT Badge -->
        <TextView
            android:id="@+id/ht_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FF9800"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:text="HT"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <!-- Score Row -->
        <LinearLayout
            android:id="@+id/ht_score_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="invisible">

            <ImageView
                android:id="@+id/ht_logo_home"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/ht_score_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="0 - 0"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ht_logo_away"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <TextView
            android:id="@+id/ht_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Half Time"
            android:textColor="#88FFFFFF"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:visibility="invisible" />

        <!-- Scorers Summary -->
        <TextView
            android:id="@+id/ht_scorers_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#E7C16A"
            android:textSize="10sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center"
            android:visibility="invisible" />

    </LinearLayout>
</FrameLayout>
