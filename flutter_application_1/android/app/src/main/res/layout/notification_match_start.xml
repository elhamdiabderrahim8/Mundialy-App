<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="128dp"
    android:background="#0D0D1A">

    <!-- Background scindé (Drapeaux) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/flag_left_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="centerCrop"
            android:alpha="0.5" />
        <ImageView
            android:id="@+id/flag_right_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="centerCrop"
            android:alpha="0.5" />
    </LinearLayout>

    <!-- Overlay sombre pour la lisibilité -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- Ligne de terrain centrale (Animation) -->
    <View
        android:id="@+id/pitch_line"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_gravity="center"
        android:background="#33FFFFFF" />

    <!-- Pill LIVE -->
    <TextView
        android:id="@+id/live_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:background="#FF3333"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="🔴 LIVE"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="invisible" />

    <!-- Contenu Principal (Logos et Noms) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:id="@+id/home_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="invisible">
            <ImageView
                android:id="@+id/logo_home_start"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/name_home_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/vs_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:text="VS"
            android:textColor="#E7C16A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/away_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="invisible">
            <ImageView
                android:id="@+id/logo_away_start"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/name_away_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer Infos -->
    <TextView
        android:id="@+id/match_info_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:textColor="#AAAAAA"
        android:textSize="10sp"
        android:visibility="invisible" />
</FrameLayout>
