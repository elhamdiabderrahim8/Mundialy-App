<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:background="#1A1F2E">

    <View 
        android:layout_width="match_parent" 
        android:layout_height="2dp" 
        android:background="#3DD68C" 
        android:layout_gravity="top" />

    <LinearLayout 
        android:layout_width="match_parent" 
        android:layout_height="match_parent" 
        android:orientation="horizontal">

        <LinearLayout 
            android:layout_width="0dp" 
            android:layout_height="match_parent" 
            android:layout_weight="1" 
            android:orientation="vertical" 
            android:gravity="center">
            
            <ImageView 
                android:id="@+id/iv_home_logo" 
                android:layout_width="44dp" 
                android:layout_height="44dp" />
            
            <TextView 
                android:id="@+id/tv_home_name" 
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content" 
                android:layout_marginTop="4dp" 
                android:textColor="#73FFFFFF" 
                android:textSize="10sp" 
                android:singleLine="true" 
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout 
            android:layout_width="0dp" 
            android:layout_height="match_parent" 
            android:layout_weight="1.5" 
            android:orientation="vertical" 
            android:gravity="center">

            <TextView 
                android:id="@+id/tv_live_badge" 
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content" 
                android:text="● LIVE" 
                android:textColor="#3DD68C" 
                android:textSize="10sp" 
                android:textStyle="bold" />
            
            <TextView 
                android:id="@+id/tv_vs" 
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content" 
                android:text="VS" 
                android:textColor="#40FFFFFF" 
                android:textSize="11sp" 
                android:layout_marginVertical="4dp" />
            
            <TextView 
                android:id="@+id/tv_competition" 
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content" 
                android:textColor="#59FFFFFF" 
                android:textSize="10sp" 
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout 
            android:layout_width="0dp" 
            android:layout_height="match_parent" 
            android:layout_weight="1" 
            android:orientation="vertical" 
            android:gravity="center">
            
            <ImageView 
                android:id="@+id/iv_away_logo" 
                android:layout_width="44dp" 
                android:layout_height="44dp" />
            
            <TextView 
                android:id="@+id/tv_away_name" 
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content" 
                android:layout_marginTop="4dp" 
                android:textColor="#73FFFFFF" 
                android:textSize="10sp" 
                android:singleLine="true" 
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
