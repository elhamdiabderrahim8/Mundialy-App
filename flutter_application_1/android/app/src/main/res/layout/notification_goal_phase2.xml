<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0D0D1A"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/score_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Home Team -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/logo_home"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/name_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textAllCaps="true" />
        </LinearLayout>

        <!-- Score Central -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="16dp">
            <TextView
                android:id="@+id/score_home_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E7C16A"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" – "
                android:textColor="#E7C16A"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/score_away_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E7C16A"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Away Team -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/logo_away"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/name_away"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textAllCaps="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Infos Buteur -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/score_container"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/scorer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚽ Mbappé"
            android:textColor="#E7C16A"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/goal_minute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#33FFFFFF"
            android:paddingHorizontal="6dp"
            android:text="72'"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/penalty_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="#FF3333"
            android:paddingHorizontal="4dp"
            android:text="PEN"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>
</RelativeLayout>
